# Supabase project settings (Project Settings > API i Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key bruges kun server-side (fx i Apify-webhooken) til at
# skrive priser uden RLS-begrænsninger. Må ALDRIG eksponeres til klienten.
SUPABASE_SERVICE_ROLE_KEY=

# Delt hemmelighed som Apify skal sende med i webhook-requests, så vi kan
# verificere at kaldet faktisk kommer fra vores Apify actor.
APIFY_WEBHOOK_SECRET=
