# Kopiér til .env.local og udfyld. Skriv værdien DIREKTE efter "=" (intet mellemrum).

# --- Bruges af appen (Next.js) -----------------------------------------------
# Supabase project settings (Project Settings > API i Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Bruges kun af scripts/ (ikke af appen) ----------------------------------
# Service role key omgår RLS. Bruges af scripts/check_database.ts, backup_data.ts,
# generate_descriptions.ts og generate_countries.ts. Må ALDRIG eksponeres til
# klienten og må ikke have NEXT_PUBLIC_ som prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Mistral API-nøgle til scripts/generate_descriptions.ts og generate_countries.ts
MISTRAL_API_KEY=

# --- Ikke i brug i dag -------------------------------------------------------
# Hører til app/api/apify-webhook/route.ts, som kun logger og ikke verificerer
# noget. Ruten fjernes eller sikres i skridt 4 i PLAN.md.
APIFY_WEBHOOK_SECRET=

# Bemærk: DATABASE_URL (til npm run backup:pg) skal IKKE stå her. Sæt den kun
# midlertidigt i din terminal med `export DATABASE_URL=...`.
